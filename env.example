# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
# For MongoDB Atlas, use: mongodb+srv://username:password@cluster.mongodb.net/cybershield
# For local MongoDB, use: mongodb://localhost:27017/cybershield
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/cybershield

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# Email Configuration (Gmail)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
